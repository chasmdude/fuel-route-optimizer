# ---------------------------------------------------------------------------
# Fuel Route Optimizer -- Environment Variables
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

# Django
SECRET_KEY=change-me-to-a-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostGIS)
DATABASE_URL=postgis://postgres:postgres@postgres:5432/fuel_route

# Redis
REDIS_URL=redis://redis:6379/0

# OpenRouteService
ORS_API_KEY=your-ors-api-key-here
ORS_BASE_URL=https://api.openrouteservice.org

# Fuel Optimizer (optional -- defaults shown)
# VEHICLE_RANGE_MILES=500
# VEHICLE_MPG=10
# CORRIDOR_BUFFER_MILES=25.0

# Production only
# SECURE_SSL_REDIRECT=True
